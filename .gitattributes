# ============================================================================
# 统一换行符与文件属性，避免跨平台协作产生无意义的 diff
# ============================================================================

# 默认由 Git 自动判定文本文件并统一存储为 LF
* text=auto

# Windows 脚本使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本使用 LF
*.sh  text eol=lf

# 二进制文件不做任何换行转换
*.jar   binary
*.war   binary
*.class binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text
*.pdf   binary
*.woff  binary
*.woff2 binary

# 语言识别，便于 GitHub 统计与语法高亮
*.java  linguist-language=Java
*.yml   linguist-language=YAML
*.yaml  linguist-language=YAML
*.sql   linguist-language=SQL
