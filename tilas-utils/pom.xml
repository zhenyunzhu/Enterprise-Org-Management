<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.itheima</groupId>
        <artifactId>tilas-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>tilas-utils</artifactId>
    <packaging>jar</packaging>

    <name>tilas-utils</name>
    <description>公共工具类：JWT、阿里云 OSS、ThreadLocal 上下文等</description>

    <dependencies>
        <!-- 依赖数据模型层（AliyunOSSOperator 使用 AliyunOSSProperties） -->
        <dependency>
            <groupId>com.itheima</groupId>
            <artifactId>tilas-pojo</artifactId>
        </dependency>

        <!-- @Component / @Value / @ConfigurationProperties 支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt</artifactId>
        </dependency>
        <!-- jjwt 0.9.1 依赖 javax.xml.bind.DatatypeConverter，JDK 11+ 需补回 -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
        </dependency>
        <dependency>
            <groupId>javax.activation</groupId>
            <artifactId>activation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
        </dependency>

        <!-- 阿里云 OSS -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
